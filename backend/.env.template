# Database
DATABASE_URL=postgresql://user:password@localhost:5432/reflections

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth2/OIDC — leave blank to use username/password mode
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_ISSUER_URL=
OAUTH2_REDIRECT_URI=http://localhost:3001/api/auth/oidc/callback
SUPER_ADMIN_EMAILS=

# AI — OpenAI-compatible endpoint (LiteLLM or compatible proxy)
AI_BASE_URL=http://localhost:4000/v1
AI_API_KEY=your-api-key
AI_MODEL=claude-sonnet-4-6

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Disable Prisma telemetry (required for air-gap)
CHECKPOINT_DISABLE=1
